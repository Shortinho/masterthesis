# Iteration 1
xrf_elements1 <- c("Fe","Mn","S","Ti","Al","Si","K","Rb","Ca","Ba",'Zr', 'position..mm.')
ratios1 <- list(c('Mn', 'Fe'), c('S', 'Ti'), c('Fe', 'Ti'), c('Si', 'Ti'),
c('Ba', 'Ti'), c('Ca', 'Ti'), c('Ti', 'Al'), c('Si', 'Al'), c('Zr', 'Rb'))
kept_vars1 <- c("Fe","Mn","S","Ti","Al","Si","K","Rb","Ca","Ba",'Zr',"Mn_Fe","S_Ti","Fe_Ti",
"Si_Ti","Ba_Ti", 'Ca_Ti',"Ti_Al",'Si_Al','Zr_Rb')
extra_vars1 <- c('Moving.Average', 'TCWt', 'position..mm.')
run_pca_selection_iteration(xrf_elements1, ratios1, kept_vars1, extra_vars1, no_xrf_combined, "1")
# Iteration 2
xrf_elements2 <- xrf_elements1
ratios2 <- ratios1[-which(sapply(ratios1, function(x) identical(x, c('Si', 'Al'))))]
kept_vars2 <- c("Ti","Ba",'Zr',"Mn_Fe","S_Ti","Fe_Ti","Si_Ti","Ba_Ti", 'Ca_Ti',"Ti_Al",'Zr_Rb')
extra_vars2 <- c('TCWt', 'position..mm.')
run_pca_selection_iteration(xrf_elements2, ratios2, kept_vars2, extra_vars2, no_xrf_combined, "2")
