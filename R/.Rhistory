# Extract PC1 series
x <- scores_age$PC1
# ---------------------------
# 1. Autocorrelation Function
# ---------------------------
acf_res <- acf(x, plot = FALSE)
# Autocorrelation length (ACL):
# find the first lag where ACF crosses zero
acl_index <- which(acf_res$acf < 0)[1]  # lag index
acl_points <- acl_index - 1             # convert to points
cat("Autocorrelation length (in points):", acl_points, "\n")
cat("Autocorrelation length (in years):", acl_points * 0.5, "\n\n")
acf(x)
acl_index
acf(x, lag.max = 100)
scores_age$age[100]-scores_age$age[196]
scores_age$age[200]-scores_age$age[296]
sapply(scores_age$age[x]-scores_age$age[x+96], mean())
