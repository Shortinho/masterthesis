distance_col = NULL
) %>%
rename(position..mm. = position..mm..x) %>%
rename('TCWt' = 'TC%/Wt')
cor(inc.coh_matched$TCWt, inc.coh_matched$Cr.inc_Cr.coh) # low pearson correlation (r = 0.26)
cor(inc.coh_matched$TCWt, inc.coh_matched$Cr.inc_Cr.coh, method = 'spearman')
