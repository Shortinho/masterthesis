source('xrf_functions.R')
# import
df.raw <- load_raw_data()
# remove unwanted variables (keep only position and element counts)
df.clean <- clean_df(df.raw)
df.clean.top <- map(df.clean, select_top_varves)
# Selection of elements
all_elements <- c("Al", "Si", "P", "S", "K", "Ca", "Ti", "Mn", "Fe", "Ni", "Zn", "Rb", "Sr", "Zr", "Ba")
# dataframes without Zr, Ni and Al for clearer PCA
selection <- c("Si", "P", "S", "K", "Ca", "Ti", "Mn", "Fe", "Zn", "Rb", "Sr", "Ba")
selection2 <- c("P", "S", "K", "Ca", "Ti", "Fe", "Zn", "Rb", "Ba")
df.clean.partial <- map(df.clean, ~select_elements(.x, elements = selection))
df.clean.partial.top <- map(df.clean.top, ~select_elements(.x, elements = selection))
df.clean.partial.top2 <- map(df.clean.top, ~select_elements(.x, elements = selection2))
# apply centered log ratio transform
df.clr <- map(df.clean, clr_transform)
df.clr.top <- map(df.clean.top, clr_transform)
df.clr.partial <- map(df.clean.partial, clr_transform)
df.clr.partial.top <- map(df.clean.partial.top, clr_transform)
df.clr.partial.top2 <- map(df.clean.partial.top2, clr_transform)
library(compositions)
library(cluster)
library(NbClust)
library(factoextra)
# Exclude the 'position..mm.' column
data_clr <- df.clr[, !names(df.clr) %in% "position..mm."]
# Exclude the 'position..mm.' column
data_clr200 <- df.clr$raw.200[, !names(df.clr) %in% "position..mm."]
# Elbow method
fviz_nbclust(data_clr200, kmeans, method = "wss")
# Silhouette method
fviz_nbclust(data_clr200, kmeans, method = "silhouette")
# Gap statistic
set.seed(123)
gap_stat <- clusGap(data_clr200, FUN = kmeans, K.max = 10, B = 500)
fviz_gap_stat(gap_stat)
# Alternatively, use NbClust
nb <- NbClust(data_clr200, distance = "euclidean", min.nc = 2, max.nc = 10, method = "kmeans")
# Alternatively, use NbClust
nb <- NbClust(data_clr200, distance = "euclidean", min.nc = 2, max.nc = 10, method = "kmeans")
# Alternatively, use NbClust
nb <- NbClust(data_clr200, distance = NULL, min.nc = 2, max.nc = 10, method = "kmeans")
# Alternatively, use NbClust
nb <- NbClust(data_clr200, distance = NULL, min.nc = 2, max.nc = 10, method = "kmeans")
# Alternatively, use NbClust
nb <- NbClust(data_clr200, distance = "euclidean", min.nc = 2, max.nc = 10, method = "kmeans", diss=NULL)
# Alternatively, use NbClust
nb <- NbClust(data_clr200, distance = "euclidean", min.nc = 2, max.nc = 10, method = "kmeans", diss=NULL)
