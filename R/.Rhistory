ratios3 <- list(c('Mn', 'Fe'), c('S', 'Ti'), c('Fe', 'Ti'), c('Si', 'Ti'),
c('Ba', 'Ti'), c('Ca', 'Ti'), c('Ti', 'Al'), c('Zr', 'Rb'))  # even if Zr not present, safe fallback
kept_vars3 <- c("Mn_Fe","S_Ti","Fe_Ti","Si_Ti", 'Ca_Ti',"Ti_Al")
extra_vars3 <- c('position..mm.')
run_pca_selection_iteration(xrf_elements3, ratios3, kept_vars3, extra_vars3, no_xrf_combined, "3")
